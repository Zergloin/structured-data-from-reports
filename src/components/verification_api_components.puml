@startuml verification_api_components
!include ../style.puml
!define RELATIVE_INCLUDE
!define ISIT_CONTAINER_VIEW
title Серверная верификация и проверка значений\nC4: компоненты контейнера api
!include ../shared/container_nodes/database.puml
!include ../shared/container_nodes/files.puml
!include ../shared/container_nodes/web_app.puml
Container_Boundary(api, "api: компоненты одного процесса") {
!include ../shared/components/api_controller.puml
!include ../shared/components/auth_comp.puml
!include ../shared/components/review_comp.puml
!include ../shared/components/validation_comp.puml
!include ../shared/components/repository_comp.puml
!include ../shared/components/file_store_comp.puml
}
Rel(api_controller, auth_comp, "A01: Проверяет действие и объект", "Python Call")
Rel(auth_comp, repository_comp, "A02: Читает пользователя и права", "Python Call")
Rel(api_controller, review_comp, "B07: Передаёт правки и решение", "Python Call")
Rel(review_comp, validation_comp, "B08: Проверяет значения по схеме", "Python Call")
Rel(review_comp, repository_comp, "B09: Сохраняет правки, ревизию и решение", "Python Call")
Rel(api_controller, file_store_comp, "B10: Получает оригинал для проверки", "Python Call")
Rel(web_app, api_controller, "N01: Передаёт данные пользовательских операций", "HTTPS / JSON, multipart")
Rel(repository_comp, database, "N02: Читает и записывает версии, права и задания", "SQL / PostgreSQL")
Rel(file_store_comp, files, "N16: Записывает оригинал и читает источник", "S3 API / HTTPS")
footer Стрелка: инициатор → получатель; ответы опущены. AMQP обозначает доставку команды.\nПовторы обоих обработчиков публикует dispatch_comp API через outbox.
@enduml
