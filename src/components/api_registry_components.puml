@startuml api_registry_components
!include ../style.puml
!define RELATIVE_INCLUDE
!define ISIT_CONTAINER_VIEW
title Реестр, сравнение и экспорт\nC4: компоненты контейнера api
!include ../shared/container_nodes/database.puml
!include ../shared/container_nodes/integration.puml
!include ../shared/container_nodes/integration_queue.puml
!include ../shared/container_nodes/web_app.puml
Container_Boundary(api, "api: компоненты одного процесса") {
!include ../shared/components/api_controller.puml
!include ../shared/components/auth_comp.puml
!include ../shared/components/registry_comp.puml
!include ../shared/components/export_comp.puml
!include ../shared/components/job_comp.puml
!include ../shared/components/comparison_comp.puml
!include ../shared/components/repository_comp.puml
!include ../shared/components/dispatch_comp.puml
}
Rel(api_controller, auth_comp, "A01: Проверяет действие и объект", "Python Call")
Rel(auth_comp, repository_comp, "A02: Читает пользователя и права", "Python Call")
Rel(api_controller, registry_comp, "T01: Передаёт фильтры или ID записей", "Python Call")
Rel(registry_comp, repository_comp, "T02: Читает подтверждённые версии", "Python Call")
Rel(registry_comp, comparison_comp, "T03: Передаёт значения и определения полей", "Python Call")
Rel(api_controller, export_comp, "T04: Запрашивает выгрузку выбранных версий", "Python Call")
Rel(export_comp, repository_comp, "T05: Фиксирует снимок экспорта", "Python Call")
Rel(dispatch_comp, repository_comp, "T06: Захватывает событие и отмечает публикацию", "Python Call")
Rel(export_comp, job_comp, "T07: Создаёт задание внешней выгрузки", "Python Call")
Rel(job_comp, repository_comp, "B06: Согласует состояние и команды заданий", "Python Call")
Rel(web_app, api_controller, "N01: Передаёт данные пользовательских операций", "HTTPS / JSON, multipart")
Rel(repository_comp, database, "N02: Читает и записывает версии, права и задания", "SQL / PostgreSQL")
Rel(dispatch_comp, integration_queue, "N03: Публикует команду интеграции с job_id", "AMQP / Celery JSON")
Rel(integration, api_controller, "N04: Запрашивает задание, снимок и фиксацию исхода", "HTTPS / JSON, multipart")
footer Стрелка: инициатор → получатель; ответы опущены. AMQP обозначает доставку команды.\nПовторы обоих обработчиков публикует dispatch_comp API через outbox.
@enduml
