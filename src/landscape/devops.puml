@startuml landscape_devops
!include ../style.puml
!define RELATIVE_INCLUDE
title Ландшафт L0: DevOps / Администратор интеграций

Person(admin, "Администратор интеграций", "Контролирует импорт, доставку и ошибки обмена")
Enterprise_Boundary(company, "Проектно-аналитическая компания: корпоративный ИТ-периметр") {
System(report_system, "ИС структурированных данных", "Прием отчетов, черновики, проверка, принятый реестр")
System_Ext(archive, "Корпоративный архив", "Владелец: документооборот; версии исходных отчетов")
System_Ext(bi, "Аналитическая система", "Владелец: аналитика; получает принятые снимки")
}
Enterprise_Boundary(providers, "Внешние владельцы и сети") {
System_Ext(llm, "Сервис языковых моделей", "OpenRouter: разрешенные фрагменты и кандидаты")
System_Ext(finance, "Финансовая система заказчика", "Учет подтвержденных объемов и расходов; не платежный шлюз")
}
Rel(admin, report_system, "Контролирует импорт, доставку и ошибки обмена", "HTTPS / GUI")
Rel(report_system, archive, "Запрашивает версию отчета и реквизиты", "HTTPS / REST")
Rel(report_system, llm, "Передает фрагменты и схему группы полей", "HTTPS / JSON")
Rel(report_system, bi, "Передает export_id и принятые версии", "HTTPS / JSON")
Rel(bi, finance, "Передает утвержденную сводку работ и расходов", "HTTPS / JSON; проектный внешний контракт")
footer
Финансовый обмен опосредован bi. Прямой интерфейс приложения с finance не вводится.
Разные владельцы выделены границами; внутренние контейнеры на L0 не показаны.
endfooter
@enduml
