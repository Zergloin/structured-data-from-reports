@startuml ci_pipeline
!include ../../src/style.puml
title Проверка и сборка архитектурной документации
start
:Выбрать partial или full;
:Проверить контрольные точки,
каталог, include, ID и связи;
if (Исходники согласованы?) then (да)
  :Проверить синтаксис PlantUML;
else (нет)
  :Сохранить ошибку в журнале;
  :Завершить с ненулевым кодом;
  stop
endif
if (Синтаксис корректен?) then (да)
  :Сформировать SVG и PNG
во временном каталоге;
else (нет)
  :Сохранить ошибку в журнале;
  :Завершить с ненулевым кодом;
  stop
endif
if (Изображения корректны?) then (да)
  if (Режим full?) then (да)
    :Выполнить тесты прототипов;
  else (partial)
    :Проверить синтаксис
доступных Python-файлов;
  endif
else (нет)
  :Сохранить ошибку в журнале;
  :Завершить с ненулевым кодом;
  stop
endif
if (Проверки завершились успешно?) then (да)
  :Опубликовать PNG и SVG,
сводку и журналы;
  :Завершить с кодом 0;
else (нет)
  :Сохранить ошибку в журнале;
  :Завершить с ненулевым кодом;
endif
stop
@enduml
