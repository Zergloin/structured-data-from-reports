        Component(parser_comp, "Разбор документа", "Python / Docling", "Текст, таблицы, ID фрагментов")
        Component(extractor_comp, "Извлечение значений", "Python / HTTPX", "Схема, фрагменты, ответ модели")
        Component(worker_validation_comp, "Проверка черновика", "Python / jsonschema", "Типы полей и достоверность ссылок")
    }
    Boundary(worker_adapter_layer, "Слой доступа к инфраструктуре") {
        Component(worker_repository_comp, "Репозиторий обработчика", "SQLAlchemy", "Попытки, черновики и источники")
