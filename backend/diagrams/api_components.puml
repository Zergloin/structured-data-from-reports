Container(web_app, "Веб-приложение", "React / TypeScript", "Загрузка, задания, проверка")
ContainerDb(database, "Общая база данных", "PostgreSQL / JSONB", "Версии, задания, черновики, история")
ContainerDb(files, "Хранилище файлов", "Garage / S3 API", "Неизменяемые оригиналы")
ContainerQueue(extraction_queue, "Очередь извлечения", "RabbitMQ / Celery", "Сообщение содержит job_id")

Container_Boundary(api, "api — один процесс FastAPI") {
    Boundary(api_entry_layer, "Входной слой") {
        Component(api_controller, "HTTP-контроллеры", "FastAPI / Pydantic", "Проверка запросов и ответы API")
        Component(auth_comp, "Доступ и роли", "Python", "Личность и разрешения")
    }
    Boundary(api_application_layer, "Прикладной слой") {
        Component(document_comp, "Приём документов", "Python", "Формат, checksum, версия файла")
        Component(job_comp, "Задания обработки", "Python", "Версии, статусы, повторы")
        Component(review_comp, "Работа с черновиком", "Python", "Правки и подтверждение версии")
        Component(validation_comp, "Проверка значений", "Python / jsonschema", "Ошибки полей и обязательность")
    }
    Boundary(api_adapter_layer, "Слой доступа к инфраструктуре") {
        Component(repository_comp, "Репозиторий и транзакции", "SQLAlchemy", "Метаданные, outbox, история")
        Component(file_store_comp, "Адаптер файлов", "Python / S3 SDK", "Запись оригинала по новому ключу")
        Component(dispatch_comp, "Публикация outbox", "Python / Celery client", "Фоновая корутина процесса API")
    }
}

